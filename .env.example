# InvestIQ — environment configuration template
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored — never commit real secrets. Rotate any credential
# that has ever been hardcoded in source or committed to version control.

# ── LLM / Azure OpenAI (M4 Orchestrator, apps/api/app/llm_service.py, vector_service.py) ──
# Used for: assistant chat, report generation, and RAG embeddings.
# These names match what infra/deploy.sh injects into Container Apps in production.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_GPT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_MAX_OUTPUT_TOKENS=66298
AZURE_OPENAI_REASONING_EFFORT=low

# ── Database (apps/api/app/database.py) ──
# Set USE_SQLITE=true for local dev with no Postgres running (uses ./investiq.db).
# Set USE_SQLITE=false and provide DATABASE_URL to use Postgres (required for pgvector search).
USE_SQLITE=true
DATABASE_URL=postgresql://investiq:investiq@localhost:5432/investiq

# ── Cache / State (M9, used by orchestrator + agent workers) ──
REDIS_URL=redis://localhost:6379/0

# ── Auth (apps/api/app/auth.py) ──
# Required in any non-local environment — the code falls back to an insecure
# default dev key if unset. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ── File storage (apps/api/app/routers/models.py) ──
UPLOAD_DIR=./uploads

# ── Frontend (apps/ui) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PROXY_TARGET=http://localhost:8000
